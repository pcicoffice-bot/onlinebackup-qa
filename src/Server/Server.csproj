<Project Sdk="Microsoft.NET.Sdk">
  <!-- The backup server: a Windows service in production (net8.0), runs on Linux for the automated tests. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>OnlineBackup.Server</AssemblyName>
    <RootNamespace>OnlineBackup.Server</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>SYSLIB0014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Web\*" LogicalName="web.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.53.0" />
    <ProjectReference Include="..\Core\Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <!-- the native SQLite that Microsoft.Data.Sqlite 8 brings (2.1.6) has a known flaw (GHSA-2m69-gcr7-jv3q) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
</Project>
