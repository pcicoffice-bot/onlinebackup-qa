<Project Sdk="Microsoft.NET.Sdk">
  <!-- CLI-100: the customer's backup program on Windows — a window (no console), with the icon by the clock.
       The work is done by the backup service; this program is its screen (OnlineBackup.Agent's ClientForm). -->
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>OnlineBackup.Client</AssemblyName>
    <RootNamespace>OnlineBackup.ClientApp</RootNamespace>
    <LangVersion>10</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Setup\setup.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net40" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="..\Agent\Agent.csproj" SetTargetFramework="TargetFramework=net40" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
